menu "watchdeck"

    config WATCHDECK_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Used when /sdcard/wifi.txt is absent. Put real values in the
            gitignored sdkconfig.defaults.local. Empty means do not connect.

    config WATCHDECK_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

endmenu
