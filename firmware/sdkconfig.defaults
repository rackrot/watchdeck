CONFIG_IDF_TARGET="esp32p4"

# Flash: 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: 32 MB on ESP32-P4NRW32
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# Chip revision. ESP-IDF v6.x targets P4 silicon v3.x by default, but this
# CrowPanel reports v1.3 (`esptool chip-id`), so build for <v3. A v3.x board
# would drop this line (or set CONFIG_ESP32P4_REV_MIN_300=y) and rebuild from
# a clean sdkconfig.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Partition table: the default 1 MB factory app is too small.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FATFS long filenames (wifi.txt and user files on the TF card).
CONFIG_FATFS_LFN_HEAP=y

# LVGL: 14 px default is unreadable on a 10" panel.
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Wi-Fi through the ESP32-C6 co-processor over ESP-Hosted (SDIO slot 1, 4-bit).
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=17
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=14
# C6 EN is GPIO32 (netlist, Elecrow AI demo, C6 upgrade guide). Elecrow's V1.2
# lesson sdkconfigs say 54, which is wrong. The pin parks high, which is fine for EN.
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=32
CONFIG_ESP_HOSTED_HOST_CP_RESET_STRATEGY_ALWAYS=y
CONFIG_ESP_HOSTED_HOST_CP_RESET_SETTLE_MS=1500

# USB mass storage on the native high-speed port (J16), raw TF card exposed to the host.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="rackrot"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="watchdeck"
CONFIG_TINYUSB_DESC_MSC_STRING="watchdeck"
# Empty: esp_tinyusb derives the serial number from the eFuse MAC.
CONFIG_TINYUSB_DESC_SERIAL_STRING=""

# cJSON recursion depth. The deepest legitimate message nests 4 levels; the default of 1000
# would overflow the link task stack on a hostile frame.
CONFIG_CJSON_NESTING_LIMIT=8
