{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "watchdeck",
  "version": "0.1.0",
  "identifier": "dev.rackrot.watchdeck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "watchdeck",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../fonts/inter/LICENSE.txt": "fonts/licenses/inter.txt",
      "../../fonts/roboto/OFL.txt": "fonts/licenses/roboto.txt",
      "../../fonts/fira-code/LICENSE": "fonts/licenses/fira-code.txt",
      "../../fonts/roboto-mono/OFL.txt": "fonts/licenses/roboto-mono.txt",
      "../../fonts/orbitron/OFL.txt": "fonts/licenses/orbitron.txt",
      "../../fonts/oxanium/OFL.txt": "fonts/licenses/oxanium.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
